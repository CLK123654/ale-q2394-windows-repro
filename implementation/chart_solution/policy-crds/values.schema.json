{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["lifecycle", "conversion"],
  "properties": {
    "lifecycle": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["additive", "prune"]}
      }
    },
    "conversion": {
      "type": "object",
      "required": ["serviceName", "namespace", "port"],
      "properties": {
        "serviceName": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}
